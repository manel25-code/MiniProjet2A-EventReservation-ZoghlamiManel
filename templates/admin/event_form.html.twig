{% extends 'admin/base_admin.html.twig' %}
{% block title %}{{ event.id ? 'Modifier' : 'Créer' }} un événement{% endblock %}
{% block content %}
<div class="page-header" style="display:flex;justify-content:space-between;align-items:center">
    <h1>{{ event.id ? 'Modifier l\'événement' : 'Nouvel événement' }}</h1>
    <a href="{{ path('admin_events') }}" class="btn btn-outline">← Retour</a>
</div>

<div class="card" style="max-width:700px">
    <div class="card-inner">
        {{ form_start(form, {attr: {enctype: 'multipart/form-data'}}) }}
            <div class="form-group">
                {{ form_label(form.title) }}
                {{ form_widget(form.title, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_label(form.description) }}
                {{ form_widget(form.description, {attr: {class: 'form-control', rows: 5}}) }}
            </div>
            <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem">
                <div class="form-group">
                    {{ form_label(form.date) }}
                    {{ form_widget(form.date, {attr: {class: 'form-control'}}) }}
                </div>
                <div class="form-group">
                    {{ form_label(form.seats) }}
                    {{ form_widget(form.seats, {attr: {class: 'form-control'}}) }}
                </div>
            </div>
            <div class="form-group">
                {{ form_label(form.location) }}
                {{ form_widget(form.location, {attr: {class: 'form-control'}}) }}
            </div>
            <div class="form-group">
                {{ form_label(form.imageFile) }}
                {{ form_widget(form.imageFile, {attr: {class: 'form-control'}}) }}
                {% if event.image %}
                    <small style="color:var(--muted)">Image actuelle : {{ event.image }}</small>
                {% endif %}
            </div>
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:0.85rem">
                {{ event.id ? 'Mettre à jour' : 'Créer l\'événement' }}
            </button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}