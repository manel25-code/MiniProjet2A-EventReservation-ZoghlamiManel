<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Admin{% endblock %} — EventHub</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary:#6C3FE8;--bg:#0D0D1A;--sidebar:#10101E;
            --card:#13131F;--border:rgba(255,255,255,0.08);
            --text:#E8E8F0;--muted:#888899;
        }
        *{margin:0;padding:0;box-sizing:border-box}
        body{font-family:'DM Sans',sans-serif;background:var(--bg);color:var(--text);display:flex;min-height:100vh}
        h1,h2,h3{font-family:'Sora',sans-serif}
        a{color:inherit;text-decoration:none}
        .sidebar{
            width:240px;background:var(--sidebar);border-right:1px solid var(--border);
            padding:1.5rem 1rem;display:flex;flex-direction:column;gap:0.3rem;
            position:fixed;height:100vh;
        }
        .sidebar-brand{
            font-size:1.2rem;font-weight:700;padding:0 0.5rem 1.5rem;
            color:#A78BFA;border-bottom:1px solid var(--border);margin-bottom:0.5rem;
        }
        .sidebar a{
            display:flex;align-items:center;gap:0.7rem;
            padding:0.65rem 0.8rem;border-radius:8px;
            font-size:0.88rem;color:var(--muted);transition:all 0.15s;
        }
        .sidebar a:hover,.sidebar a.active{background:rgba(108,63,232,0.15);color:var(--text)}
        .content{margin-left:240px;flex:1;padding:2rem}
        .page-header{margin-bottom:2rem;padding-bottom:1.2rem;border-bottom:1px solid var(--border)}
        .page-header h1{font-size:1.6rem}
        .card{background:var(--card);border:1px solid var(--border);border-radius:16px;overflow:hidden}
        .card-inner{padding:1.5rem}
        .btn{display:inline-flex;align-items:center;gap:0.4rem;padding:0.55rem 1.2rem;border-radius:8px;font-size:0.85rem;cursor:pointer;border:none;font-family:'DM Sans',sans-serif;transition:all 0.2s}
        .btn-primary{background:var(--primary);color:#fff}.btn-primary:hover{background:#4f2cb5}
        .btn-outline{background:transparent;border:1px solid var(--border);color:var(--text)}.btn-outline:hover{border-color:var(--primary);color:#A78BFA}
        .btn-danger{background:#EF4444;color:#fff}
        .btn-sm{padding:0.38rem 0.8rem;font-size:0.78rem}
        table{width:100%;border-collapse:collapse}
        th{text-align:left;padding:0.8rem 1rem;font-size:0.75rem;color:var(--muted);text-transform:uppercase;letter-spacing:0.05em;border-bottom:1px solid var(--border)}
        td{padding:0.9rem 1rem;border-bottom:1px solid var(--border);font-size:0.88rem;vertical-align:middle}
        tr:last-child td{border-bottom:none}
        .stats-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:1rem;margin-bottom:2rem}
        .stat-card{background:var(--card);border:1px solid var(--border);border-radius:12px;padding:1.3rem}
        .stat-number{font-size:2rem;font-weight:700;font-family:'Sora',sans-serif;color:var(--primary)}
        .stat-label{font-size:0.8rem;color:var(--muted);margin-top:0.2rem}
        .form-group{margin-bottom:1.1rem}
        .form-group label{display:block;font-size:0.82rem;color:var(--muted);margin-bottom:0.35rem}
        .form-control{width:100%;padding:0.7rem 0.9rem;background:rgba(255,255,255,0.05);border:1px solid var(--border);border-radius:8px;color:var(--text);font-size:0.9rem;font-family:'DM Sans',sans-serif}
        .form-control:focus{outline:none;border-color:var(--primary)}
        .flash{padding:0.8rem 1rem;border-radius:8px;margin-bottom:1rem;font-size:0.88rem}
        .flash-success{background:rgba(34,197,94,0.15);border:1px solid rgba(34,197,94,0.3);color:#86efac}
        .flash-error{background:rgba(239,68,68,0.15);border:1px solid rgba(239,68,68,0.3);color:#fca5a5}
        .badge{display:inline-block;padding:0.2rem 0.6rem;border-radius:5px;font-size:0.72rem;font-weight:500}
        .badge-success{background:rgba(34,197,94,0.15);color:#86efac}
        .badge-danger{background:rgba(239,68,68,0.15);color:#fca5a5}
    </style>
</head>
<body>
<aside class="sidebar">
    <div class="sidebar-brand">⚡ EventHub Admin</div>
    <a href="{{ path('admin_dashboard') }}" class="{{ app.request.attributes.get('_route') == 'admin_dashboard' ? 'active' : '' }}">
        📊 Tableau de bord
    </a>
    <a href="{{ path('admin_events') }}" class="{{ 'admin_event' in app.request.attributes.get('_route') ? 'active' : '' }}">
        🎭 Événements
    </a>
    <div style="flex:1"></div>
    <a href="{{ path('admin_logout') }}" style="color:#EF4444">🚪 Déconnexion</a>
</aside>

<div class="content">
    {% for msg in app.flashes('success') %}<div class="flash flash-success">✓ {{ msg }}</div>{% endfor %}
    {% for msg in app.flashes('error') %}<div class="flash flash-error">✕ {{ msg }}</div>{% endfor %}
    {% block content %}{% endblock %}
</div>
</body>
</html>