<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}EventHub{% endblock %}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700&family=DM+Sans:wght@400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #6C3FE8;
            --primary-dark: #4f2cb5;
            --accent: #F5A623;
            --bg: #0D0D1A;
            --card: #13131F;
            --card2: #1A1A2E;
            --border: rgba(255,255,255,0.08);
            --text: #E8E8F0;
            --muted: #888899;
            --success: #22C55E;
            --danger: #EF4444;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }
        h1,h2,h3,h4 { font-family: 'Sora', sans-serif; }
        a { color: inherit; text-decoration: none; }

        /* NAV */
        nav {
            background: rgba(13,13,26,0.85);
            backdrop-filter: blur(20px);
            border-bottom: 1px solid var(--border);
            padding: 0 2rem;
            position: sticky; top: 0; z-index: 100;
        }
        .nav-inner {
            max-width: 1200px; margin: 0 auto;
            display: flex; align-items: center; justify-content: space-between;
            height: 64px;
        }
        .nav-brand {
            font-family: 'Sora', sans-serif;
            font-size: 1.4rem; font-weight: 700;
            background: linear-gradient(135deg, #6C3FE8, #A78BFA);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .nav-links { display: flex; gap: 0.5rem; align-items: center; }
        .nav-link {
            padding: 0.5rem 1rem; border-radius: 8px;
            font-size: 0.9rem; transition: all 0.2s;
            color: var(--muted);
        }
        .nav-link:hover { background: rgba(108,63,232,0.15); color: var(--text); }
        .btn {
            display: inline-flex; align-items: center; gap: 0.5rem;
            padding: 0.6rem 1.4rem; border-radius: 10px;
            font-family: 'DM Sans', sans-serif; font-weight: 500;
            font-size: 0.9rem; cursor: pointer; border: none;
            transition: all 0.2s; text-decoration: none;
        }
        .btn-primary {
            background: var(--primary);
            color: #fff;
        }
        .btn-primary:hover { background: var(--primary-dark); transform: translateY(-1px); }
        .btn-outline {
            background: transparent; color: var(--text);
            border: 1px solid var(--border);
        }
        .btn-outline:hover { border-color: var(--primary); color: var(--primary); }
        .btn-danger { background: var(--danger); color: #fff; }
        .btn-sm { padding: 0.4rem 0.9rem; font-size: 0.82rem; }

        /* FLASH MESSAGES */
        .flash-container { max-width: 1200px; margin: 1rem auto; padding: 0 2rem; }
        .flash {
            padding: 0.9rem 1.2rem; border-radius: 10px;
            margin-bottom: 0.5rem; font-size: 0.9rem;
            display: flex; align-items: center; gap: 0.6rem;
        }
        .flash-success { background: rgba(34,197,94,0.15); border: 1px solid rgba(34,197,94,0.3); color: #86efac; }
        .flash-error   { background: rgba(239,68,68,0.15);  border: 1px solid rgba(239,68,68,0.3);  color: #fca5a5; }

        /* MAIN CONTENT */
        main { max-width: 1200px; margin: 0 auto; padding: 2.5rem 2rem; }

        /* CARDS */
        .card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: 16px; overflow: hidden;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        .card:hover { transform: translateY(-3px); box-shadow: 0 16px 40px rgba(108,63,232,0.15); }
        .card-img { width: 100%; height: 200px; object-fit: cover; }
        .card-img-placeholder {
            width: 100%; height: 200px;
            background: linear-gradient(135deg, #1A1A2E, #2D2D4E);
            display: flex; align-items: center; justify-content: center;
            font-size: 3rem; color: var(--muted);
        }
        .card-body { padding: 1.4rem; }
        .card-title { font-family: 'Sora', sans-serif; font-size: 1.1rem; font-weight: 600; margin-bottom: 0.5rem; }
        .card-meta { font-size: 0.82rem; color: var(--muted); margin-bottom: 0.8rem; display: flex; flex-direction: column; gap: 0.2rem; }
        .badge {
            display: inline-block; padding: 0.25rem 0.7rem;
            border-radius: 6px; font-size: 0.75rem; font-weight: 500;
        }
        .badge-success { background: rgba(34,197,94,0.15); color: #86efac; border: 1px solid rgba(34,197,94,0.2); }
        .badge-danger  { background: rgba(239,68,68,0.15);  color: #fca5a5; border: 1px solid rgba(239,68,68,0.2); }
        .badge-primary { background: rgba(108,63,232,0.2);  color: #c4b5fd; border: 1px solid rgba(108,63,232,0.3); }

        /* GRID */
        .events-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px,1fr)); gap: 1.5rem; }

        /* FORMS */
        .form-group { margin-bottom: 1.2rem; }
        .form-group label { display: block; font-size: 0.85rem; color: var(--muted); margin-bottom: 0.4rem; }
        .form-control {
            width: 100%; padding: 0.75rem 1rem;
            background: rgba(255,255,255,0.05); border: 1px solid var(--border);
            border-radius: 10px; color: var(--text); font-size: 0.95rem;
            font-family: 'DM Sans', sans-serif;
            transition: border-color 0.2s;
        }
        .form-control:focus { outline: none; border-color: var(--primary); background: rgba(108,63,232,0.08); }
        .form-control option { background: var(--card); }

        /* PAGE HEADER */
        .page-header {
            margin-bottom: 2.5rem; padding-bottom: 1.5rem;
            border-bottom: 1px solid var(--border);
        }
        .page-header h1 { font-size: 2rem; font-weight: 700; margin-bottom: 0.4rem; }
        .page-header p { color: var(--muted); }

        /* TABLE */
        table { width: 100%; border-collapse: collapse; }
        th { text-align: left; padding: 0.8rem 1rem; font-size: 0.78rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid var(--border); }
        td { padding: 1rem; border-bottom: 1px solid var(--border); font-size: 0.9rem; vertical-align: middle; }
        tr:hover td { background: rgba(255,255,255,0.02); }

        /* STATS */
        .stats-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px,1fr)); gap: 1rem; margin-bottom: 2rem; }
        .stat-card {
            background: var(--card2); border: 1px solid var(--border);
            border-radius: 12px; padding: 1.4rem;
        }
        .stat-number { font-size: 2.2rem; font-weight: 700; font-family: 'Sora', sans-serif; color: var(--primary); }
        .stat-label { font-size: 0.82rem; color: var(--muted); margin-top: 0.25rem; }

        /* HERO */
        .hero {
            text-align: center; padding: 5rem 1rem 3rem;
            background: radial-gradient(ellipse at 50% 0%, rgba(108,63,232,0.15) 0%, transparent 70%);
        }
        .hero h1 { font-size: clamp(2rem, 5vw, 3.5rem); font-weight: 700; line-height: 1.15; margin-bottom: 1rem; }
        .hero p { color: var(--muted); font-size: 1.1rem; max-width: 560px; margin: 0 auto 2rem; }
        .gradient-text {
            background: linear-gradient(135deg, #6C3FE8, #A78BFA, #F5A623);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }

        /* LOGIN */
        .auth-container {
            min-height: 80vh; display: flex; align-items: center; justify-content: center;
        }
        .auth-card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: 20px; padding: 2.5rem; width: 100%; max-width: 440px;
        }
        .auth-title { font-size: 1.6rem; font-weight: 700; margin-bottom: 0.4rem; }
        .auth-subtitle { color: var(--muted); font-size: 0.9rem; margin-bottom: 2rem; }
        .divider {
            display: flex; align-items: center; gap: 1rem;
            color: var(--muted); font-size: 0.82rem; margin: 1.5rem 0;
        }
        .divider::before, .divider::after {
            content: ''; flex: 1; height: 1px; background: var(--border);
        }
        .passkey-btn {
            width: 100%; padding: 0.85rem; border-radius: 12px;
            background: rgba(108,63,232,0.12); border: 1px solid rgba(108,63,232,0.3);
            color: var(--text); font-size: 0.95rem; cursor: pointer;
            display: flex; align-items: center; justify-content: center; gap: 0.7rem;
            transition: all 0.2s; font-family: 'DM Sans', sans-serif;
        }
        .passkey-btn:hover { background: rgba(108,63,232,0.2); border-color: var(--primary); }

        /* DETAIL PAGE */
        .event-detail { display: grid; grid-template-columns: 1fr 380px; gap: 2rem; }
        .event-detail-img { width: 100%; height: 360px; object-fit: cover; border-radius: 16px; }
        .info-card {
            background: var(--card); border: 1px solid var(--border);
            border-radius: 16px; padding: 1.8rem; position: sticky; top: 80px;
        }
        @media (max-width: 800px) { .event-detail { grid-template-columns: 1fr; } }

        /* FOOTER */
        footer {
            margin-top: 4rem; border-top: 1px solid var(--border);
            padding: 2rem; text-align: center; color: var(--muted); font-size: 0.82rem;
        }
    </style>
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav>
    <div class="nav-inner">
        <a href="{{ path('event_list') }}" class="nav-brand">⚡ EventHub</a>
        <div class="nav-links">
            <a href="{{ path('event_list') }}" class="nav-link">Événements</a>
            {% if is_granted('ROLE_USER') %}
                <a href="{{ path('app_logout') }}" class="btn btn-outline btn-sm">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="nav-link">Se connecter</a>
                <a href="{{ path('user_register') }}" class="btn btn-primary btn-sm">S'inscrire</a>
            {% endif %}
        </div>
    </div>
</nav>

<div class="flash-container">
    {% for msg in app.flashes('success') %}
        <div class="flash flash-success">✓ {{ msg }}</div>
    {% endfor %}
    {% for msg in app.flashes('error') %}
        <div class="flash flash-error">✕ {{ msg }}</div>
    {% endfor %}
</div>

{% block body %}{% endblock %}

<footer>© 2026 EventHub — ISSAT Sousse — FIA3-GL</footer>
{% block javascripts %}{% endblock %}
</body>
</html>