{% extends 'base.html.twig' %}
{% block title %}Connexion{% endblock %}
{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <h1 class="auth-title">Bon retour !</h1>
        <p class="auth-subtitle">Connectez-vous pour réserver vos événements</p>

        {% if error %}
            <div class="flash flash-error">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post" action="{{ path('app_login') }}">
            <div class="form-group">
                <label>Email</label>
                <input type="email" name="_username" class="form-control" value="{{ last_username }}" placeholder="votre@email.com" required autofocus>
            </div>
            <div class="form-group">
                <label>Mot de passe</label>
                <input type="password" name="_password" class="form-control" placeholder="••••••••" required>
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;padding:0.85rem">
                Se connecter
            </button>
        </form>

        <div class="divider">ou</div>

        <button class="passkey-btn" onclick="loginWithPasskey()">
            <span style="font-size:1.2rem">🔑</span>
            Connexion avec Passkey (biométrie)
        </button>

        <p style="text-align:center;margin-top:1.5rem;font-size:0.85rem;color:var(--muted)">
            Pas encore de compte ? <a href="{{ path('user_register') }}" style="color:#A78BFA">S'inscrire</a>
        </p>
    </div>
</div>
{% endblock %}
{% block javascripts %}
<script src="{{ asset('js/auth.js') }}"></script>
{% endblock %}